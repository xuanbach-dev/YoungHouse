{
  "version": 2,
  "framework": "create-react-app",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node"
    },
    {
      "src": "build/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "v-max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "build",
  "env": {
    "REACT_APP_EMAILJS_PUBLIC_KEY": "@emailjs_public_key",
    "REACT_APP_EMAILJS_SERVICE_ID": "@emailjs_service_id",
    "REACT_APP_EMAILJS_TEMPLATE_CUSTOMER": "@emailjs_template_customer",
    "REACT_APP_EMAILJS_TEMPLATE_ADMIN": "@emailjs_template_admin"
  }
}
